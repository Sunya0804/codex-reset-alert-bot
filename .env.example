# Watched accounts as name:product (product: codex or claude). Overrides X_USERNAME.
X_ACCOUNTS=thsottiaux:codex,claudedevs:claude
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. Alerts go to every configured channel (Telegram and/or Discord).
DISCORD_WEBHOOK_URL=
POLL_SECONDS=300
DISPLAY_TIMEZONE=Asia/Seoul
SOURCE_TIMEZONE=America/Los_Angeles
INITIAL_LOOKBACK_HOURS=24
STATE_PATH=data/state.sqlite3
# Uses Codex CLI's saved ChatGPT login, not an API key.
AI_ENABLED=true
# Leave blank to use the installed Codex CLI's default model.
CODEX_MODEL=
# Optional absolute codex.exe path if not on PATH.
CODEX_COMMAND=
CODEX_TIMEOUT_SECONDS=120
AI_MAX_POSTS_PER_POLL=10
# Optional schedule reminders, minutes before the announced time. Blank disables.
# Example: REMINDER_MINUTES=10,0 (10 minutes before and at the scheduled time).
REMINDER_MINUTES=
# Repeat unresolved outage notices at this interval; status survives restarts.
HEALTH_REPEAT_MINUTES=60
# Completed post bodies, analyses and delivery history retention; pending work is kept.
RETENTION_DAYS=90
